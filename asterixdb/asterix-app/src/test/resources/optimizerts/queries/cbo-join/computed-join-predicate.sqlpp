/*
 * Description  : Plan level guard for a join predicate that is a computed expression over two
 *              : fields of an unnested array, with sample statistics present. The cost based
 *              : optimizer must estimate the selectivity from the samples rather than fail to
 *              : compile or fall back to the default selectivity, which would change the join
 *              : order recorded in the expected plan.
 * Expected Res : Success
 */


drop dataverse test if exists;
create dataverse test;
use test;

-- autogenerated primary keys, so none of the join keys below is a primary key and the cost based
-- optimizer has to estimate the join selectivities from the samples
create dataset orders(id uuid not unknown) open type primary key `id` autogenerated;
create dataset item(id uuid not unknown) open type primary key `id` autogenerated;
create dataset supplier(id uuid not unknown) open type primary key `id` autogenerated;
create dataset nation(id uuid not unknown) open type primary key `id` autogenerated;
create dataset region(id uuid not unknown) open type primary key `id` autogenerated;

use test;

INSERT INTO orders (
    SELECT VALUE {
        "o_id": i,
        "o_c_id": i % 300,
        "o_entry_d": "2016-01-02 00:00:00.000000",
        "o_orderline": [
            { "ol_i_id": i % 60, "ol_supply_w_id": i % 9, "ol_quantity": i % 5 },
            { "ol_i_id": (i + 1) % 60, "ol_supply_w_id": (i + 2) % 9, "ol_quantity": i % 3 }
        ]
    }
    FROM range(1, 2000) i
);

INSERT INTO item (
    SELECT VALUE { "i_id": i, "i_data": "xyzab" }
    FROM range(0, 59) i
);

INSERT INTO supplier (
    SELECT VALUE { "su_suppkey": i, "su_nationkey": i % 25 }
    FROM range(0, 99) i
);

INSERT INTO nation (
    SELECT VALUE { "n_nationkey": i, "n_regionkey": i % 5, "n_name": "nation-" || string(i) }
    FROM range(0, 24) i
);

INSERT INTO region (
    SELECT VALUE { "r_regionkey": i, "r_name": "region-" || string(i) }
    FROM range(0, 4) i
);

use test;

ANALYZE DATASET orders with {"sample": "high", "sample-seed": 12345};
ANALYZE DATASET item with {"sample": "high", "sample-seed": 12345};
ANALYZE DATASET supplier with {"sample": "high", "sample-seed": 12345};
ANALYZE DATASET nation with {"sample": "high", "sample-seed": 12345};
ANALYZE DATASET region with {"sample": "high", "sample-seed": 12345};

use test;

SELECT r.r_name AS region, su.su_nationkey AS supplier_nation,
       COUNT(DISTINCT ol.ol_i_id) AS unique_items_ordered,
       COUNT(DISTINCT o.o_c_id)   AS unique_customers,
       SUM(ol.ol_quantity)        AS total_quantity_ordered
FROM orders o, o.o_orderline ol, item i, supplier su, nation n, region r
WHERE ol.ol_i_id = i.i_id
  AND i.i_data LIKE '%b'
  AND ol.ol_supply_w_id * ol.ol_i_id MOD 100 = su.su_suppkey
  AND su.su_nationkey = n.n_nationkey
  AND n.n_regionkey = r.r_regionkey
  AND o.o_entry_d >= '2016-01-01 00:00:00.000000'
GROUP BY r.r_name, su.su_nationkey
ORDER BY total_quantity_ordered DESC, region, supplier_nation;
