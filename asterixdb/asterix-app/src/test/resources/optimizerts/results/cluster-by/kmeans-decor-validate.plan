distribute result [$$94]
-- DISTRIBUTE_RESULT  |PARTITIONED|
  exchange
  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
    assign [$$94] <- [{"cid": $#1, "t": $$91, "cnt": $$96}] project: [$$94]
    -- ASSIGN  |PARTITIONED|
      exchange
      -- SORT_MERGE_EXCHANGE [$#1(ASC) ]  |PARTITIONED|
        group by ([$#1 := $$105]) decor ([$$91 := $$85]) {
                  aggregate [$$96] <- [agg-sql-count(1)] [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                  -- AGGREGATE  |LOCAL|
                    nested tuple source [cardinality: 0.0, doc-size: 0.0, op-cost: 0.0, total-cost: 0.0]
                    -- NESTED_TUPLE_SOURCE  |LOCAL|
               }
        -- SORT_GROUP_BY[$$105]  |PARTITIONED|
          exchange
          -- HASH_PARTITION_EXCHANGE [$$105]  |PARTITIONED|
            select (not(is-unknown($$105)))
            -- STREAM_SELECT  |PARTITIONED|
              assign [$$90] <- [get-item($$104, $$105)] project: [$$85, $$105, $$90]
              -- ASSIGN  |PARTITIONED|
                assign [$$105] <- [nearest-centroid($$88, $$104, "euclidean_squared")] project: [$$85, $$104, $$105]
                -- ASSIGN  |PARTITIONED|
                  exchange
                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                    join (true)
                    -- NESTED_LOOP  |PARTITIONED|
                      exchange
                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                        replicate
                        -- REPLICATE  |PARTITIONED|
                          exchange
                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                            assign [$$89, $$88] <- [{"r": $$r}, $$r.getField(1)] project: [$$88, $$89, $$85, $$88, $$85]
                            -- ASSIGN  |PARTITIONED|
                              project ([$$85, $$r])
                              -- STREAM_PROJECT  |PARTITIONED|
                                exchange
                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                  data-scan []<-[$$95, $$r] <- clusterby_test.Reviews
                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                    exchange
                                    -- BROADCAST_EXCHANGE  |PARTITIONED|
                                      assign [$$85] <- [current-datetime()]
                                      -- ASSIGN  |UNPARTITIONED|
                                        empty-tuple-source
                                        -- EMPTY_TUPLE_SOURCE  |UNPARTITIONED|
                      exchange
                      -- BROADCAST_EXCHANGE  |PARTITIONED|
                        aggregate [$$104] <- [listify($$103)]
                        -- AGGREGATE  |UNPARTITIONED|
                          exchange
                          -- SORT_MERGE_EXCHANGE [$$103(ASC) ]  |PARTITIONED|
                            order (ASC, $$103)
                            -- STABLE_SORT [$$103(ASC)]  |PARTITIONED|
                              exchange
                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                kmeans-stage $$103 <- lloyd-loop 3 iterations of $$102 vs pool $$101 by euclidean_squared
                                -- KMEANS_LLOYD_LOOP  |PARTITIONED|
                                  exchange
                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                    assign [$$102] <- [$$88] project: [$$102]
                                    -- ASSIGN  |PARTITIONED|
                                      exchange
                                      -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                        replicate
                                        -- REPLICATE  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            assign [$$89, $$88] <- [{"r": $$r}, $$r.getField(1)] project: [$$88, $$89, $$85, $$88, $$85]
                                            -- ASSIGN  |PARTITIONED|
                                              project ([$$85, $$r])
                                              -- STREAM_PROJECT  |PARTITIONED|
                                                exchange
                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                  data-scan []<-[$$95, $$r] <- clusterby_test.Reviews
                                                  -- DATASOURCE_SCAN  |PARTITIONED|
                                                    exchange
                                                    -- BROADCAST_EXCHANGE  |PARTITIONED|
                                                      assign [$$85] <- [current-datetime()]
                                                      -- ASSIGN  |UNPARTITIONED|
                                                        empty-tuple-source
                                                        -- EMPTY_TUPLE_SOURCE  |UNPARTITIONED|
                                  exchange
                                  -- BROADCAST_EXCHANGE  |PARTITIONED|
                                    kmeans-stage $$101 <- recluster pool $$100 to 2 means (seed 12345) by euclidean_squared
                                    -- KMEANS_RECLUSTER  |PARTITIONED|
                                      exchange
                                      -- BROADCAST_EXCHANGE  |PARTITIONED|
                                        kmeans-stage $$100 <- oversample-loop 5 rounds of $$99 vs seed $$97 (seed 1000003) by euclidean_squared
                                        -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                          exchange
                                          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                            assign [$$99] <- [$$88] project: [$$99]
                                            -- ASSIGN  |PARTITIONED|
                                              exchange
                                              -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                replicate
                                                -- REPLICATE  |PARTITIONED|
                                                  exchange
                                                  -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                    assign [$$89, $$88] <- [{"r": $$r}, $$r.getField(1)] project: [$$88, $$89, $$85, $$88, $$85]
                                                    -- ASSIGN  |PARTITIONED|
                                                      project ([$$85, $$r])
                                                      -- STREAM_PROJECT  |PARTITIONED|
                                                        exchange
                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                          data-scan []<-[$$95, $$r] <- clusterby_test.Reviews
                                                          -- DATASOURCE_SCAN  |PARTITIONED|
                                                            exchange
                                                            -- BROADCAST_EXCHANGE  |PARTITIONED|
                                                              assign [$$85] <- [current-datetime()]
                                                              -- ASSIGN  |UNPARTITIONED|
                                                                empty-tuple-source
                                                                -- EMPTY_TUPLE_SOURCE  |UNPARTITIONED|
                                          exchange
                                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                                            limit 1
                                            -- STREAM_LIMIT  |UNPARTITIONED|
                                              project ([$$97])
                                              -- STREAM_PROJECT  |PARTITIONED|
                                                exchange
                                                -- SORT_MERGE_EXCHANGE [$$98(ASC) ]  |PARTITIONED|
                                                  limit 1
                                                  -- STREAM_LIMIT  |PARTITIONED|
                                                    exchange
                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                      order (ASC, $$98)
                                                      -- STABLE_SORT [$$98(ASC)]  |PARTITIONED|
                                                        exchange
                                                        -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                          assign [$$98] <- [random(get-item($$97, 0))]
                                                          -- ASSIGN  |PARTITIONED|
                                                            select (and(is-array($$97), eq(sql-count($$97), 2)))
                                                            -- STREAM_SELECT  |PARTITIONED|
                                                              assign [$$97] <- [$$88] project: [$$97]
                                                              -- ASSIGN  |PARTITIONED|
                                                                exchange
                                                                -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                  replicate
                                                                  -- REPLICATE  |PARTITIONED|
                                                                    exchange
                                                                    -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
                                                                      assign [$$89, $$88] <- [{"r": $$r}, $$r.getField(1)] project: [$$88, $$89, $$85, $$88, $$85]
                                                                      -- ASSIGN  |PARTITIONED|
                                                                        project ([$$85, $$r])
                                                                        -- STREAM_PROJECT  |PARTITIONED|
                                                                          exchange
