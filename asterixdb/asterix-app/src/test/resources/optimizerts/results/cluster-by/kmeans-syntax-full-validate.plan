               }
        -- PRE_CLUSTERED_GROUP_BY[$$88]  |PARTITIONED|
          exchange
          -- ONE_TO_ONE_EXCHANGE  |PARTITIONED|
            order (ASC, $$88)
            -- STABLE_SORT [$$88(ASC)]  |PARTITIONED|
              exchange
