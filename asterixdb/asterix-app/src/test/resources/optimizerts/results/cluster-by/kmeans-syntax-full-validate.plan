                                                              empty-tuple-source
                                                              -- EMPTY_TUPLE_SOURCE  |PARTITIONED|
                                      exchange
                                      -- BROADCAST_EXCHANGE  |PARTITIONED|
                                        kmeans-stage $$84 <- recluster pool $$83 to 5 means (seed 12345) by euclidean_squared
                                        -- KMEANS_RECLUSTER  |PARTITIONED|
                                          exchange
                                          -- BROADCAST_EXCHANGE  |PARTITIONED|
                                            kmeans-stage $$83 <- oversample-loop 5 rounds of $$82 vs seed $$80 (seed 1000003) by euclidean_squared
                                            -- KMEANS_OVERSAMPLE_LOOP  |PARTITIONED|
                                              exchange
