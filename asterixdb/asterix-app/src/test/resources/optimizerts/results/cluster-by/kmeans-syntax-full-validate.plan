                                                assign [$$72] <- [{"m": $$m}] project: [$$72, $$71]
                                                -- ASSIGN  |PARTITIONED|
                                                  select (lt($$m.getField(1), 2020))
                                                  -- STREAM_SELECT  |PARTITIONED|
                                                    assign [$$71] <- [$$m.getField(2)]
                                                    -- ASSIGN  |PARTITIONED|
                                                      project ([$$m])
                                                      -- STREAM_PROJECT  |PARTITIONED|
                                                        exchange
