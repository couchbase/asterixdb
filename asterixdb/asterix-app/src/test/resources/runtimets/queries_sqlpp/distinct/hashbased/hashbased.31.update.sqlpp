/*
 * Loads the open (schemaless) dataset used by 32-34. 40000 rows, each with an undeclared field `v`
 * (distinct per row) and an undeclared field `g` (two groups of 20000). Both resolve to ANY at
 * compile time.
 *
 * Sizing: with the test frame size of 32KB, a 512KB budget is 16 frames, and the in-memory table
 * crosses it at roughly 11500 distinct values. 40000 ungrouped, and 20000 per group, both clear
 * that comfortably, so every query below is guaranteed to reach the spill path.
 */

use test;

INSERT INTO emp_open (
  SELECT VALUE { "id": i, "v": i, "g": i % 2 }
  FROM range(1, 40000) AS i
);
