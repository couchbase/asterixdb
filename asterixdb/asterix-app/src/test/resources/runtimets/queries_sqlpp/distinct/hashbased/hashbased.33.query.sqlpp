/*
 * Same query as hashbased.32 with the hash rewrite disabled: the sort-based path must agree, which
 * confirms the spill path does not just avoid crashing but still counts correctly without a
 * normalized-key fast path.
 */

use test;

SET `compiler.aggregate.distinct.hash` "false";

SELECT VALUE COUNT(DISTINCT v)
FROM emp_open;
