/*
 * Grouped variant: every group of an untyped column spills. This also exercises the per-group
 * reset across the spill path (releaseTable() followed by a fresh init()) for a type with no
 * normalized-key computer, which hashbased.32 does not reach with its single group.
 */

use test;

SET `compiler.aggregate.distinct.hash` "true";
SET `compiler.aggregate.distinct.hash.memory` "512KB";

SELECT g, COUNT(DISTINCT v) AS cnt
FROM emp_open
GROUP BY g
ORDER BY g;
