-- CLUSTER BY 'num_iterations': the query's own Lloyd refinement count. Two pairs 10 units apart, so the
-- clustering is the same at every iteration count and each query below asserts the option was honoured
-- rather than rejected, defaulted away, or allowed to run unbounded.
drop dataverse test if exists;
create dataverse test;
use test;
create type PointType as open { id: bigint };
create dataset Points(PointType) primary key id;
