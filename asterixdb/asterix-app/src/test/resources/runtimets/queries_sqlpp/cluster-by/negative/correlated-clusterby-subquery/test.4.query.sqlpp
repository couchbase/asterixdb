-- The enclosing row is read in the clustering expression itself.
use test;
from [ {"shift": 0.0}, {"shift": 1.0} ] as o
select (from Points as p cluster by [p.vec[0] + o.shift, p.vec[1]] as sc
        with {"clustering_algorithm": "K-Means",  "dimension": [2], "num_clusters": 2 }
        select value sc.cluster_id) as cids;
