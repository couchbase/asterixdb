// Both derived values must reach the catalog. Asserting presence rather than the numbers themselves:
// they follow from the per-partition cardinality, so pinning them here would pin the suite's partition
// count too. The arithmetic is covered exactly by VectorIndexSizingTest.
SELECT i.num_clusters IS NOT MISSING AS records_num_clusters,
       i.train_list_fraction IS NOT MISSING AS records_train_list_fraction,
       i.num_clusters >= 1 AS num_clusters_is_positive,
       i.train_list_fraction > 0 AND i.train_list_fraction <= 1 AS fraction_in_range
FROM Metadata.`Index` i
WHERE i.DataverseName = "test" AND i.DatasetName = "MovieSmall" AND i.IndexName = "idx_emb";
