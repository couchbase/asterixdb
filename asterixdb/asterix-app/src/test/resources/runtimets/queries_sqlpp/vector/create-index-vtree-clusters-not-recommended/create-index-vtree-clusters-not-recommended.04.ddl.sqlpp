USE test;

// 30 records, so the recommendation is 1 cluster whatever the partition count: the small-data rule is
// ceil(D/100). Asking for 3 is legal and is built, but it is far enough from the recommendation to be
// worth saying so, and it warns. The warning's own conditions and text are covered by
// VectorIndexSizingTest; what this case pins is that the value is accepted and built, not rejected.
CREATE INDEX idx_emb
  ON MovieSmall(embedding VECTOR)
  TYPE VTREE
  WITH { "dimension": 4, "similarity": "euclidean", "num_clusters": 3, "seed": 42 };
