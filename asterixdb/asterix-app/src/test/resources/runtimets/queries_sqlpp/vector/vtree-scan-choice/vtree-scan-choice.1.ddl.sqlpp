// Scan-choice regression for vector-index costing: one dataset carrying both a VTREE index and a
// BTREE index, queried so that each of the three access paths wins in turn.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE VecType AS {
  id: int,
  year: int,
  category: string,
  embedding: [double]
};

CREATE DATASET Vec(VecType) PRIMARY KEY id;
