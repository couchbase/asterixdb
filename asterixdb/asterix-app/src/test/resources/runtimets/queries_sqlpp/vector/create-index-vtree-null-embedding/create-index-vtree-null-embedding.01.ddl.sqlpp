// Every record's embedding is NULL, so the sample yields no usable vector and the build cannot
// derive quantization constants. The failure must name that cause as a build failure the user can
// act on, not an internal-invariant error. The type is open so `embedding` can be NULL at all.
DROP DATAVERSE test IF EXISTS;
CREATE DATAVERSE test;
USE test;

CREATE TYPE MovieType AS {
  id: int
};

CREATE DATASET MovieSmall(MovieType) PRIMARY KEY id;
