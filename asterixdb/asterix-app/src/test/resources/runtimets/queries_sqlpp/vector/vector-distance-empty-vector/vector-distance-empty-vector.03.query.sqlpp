USE test;

// An empty vector read from a field warns and yields NULL for that row; every other row computes
// normally. A schemaless collection may hold a malformed embedding in any row. One such row does not
// fail the query.
//
// Not asserted here: an empty *literal* argument yields a denormal rather than NULL because the
// distance builtins declare a non-nullable double that a runtime NULL is read back through.
SELECT m.id, vector_distance(m.embedding, [0.1, 0.2, 0.3, 0.4], "euclidean") AS dist
FROM MovieSmall m
ORDER BY m.id;
