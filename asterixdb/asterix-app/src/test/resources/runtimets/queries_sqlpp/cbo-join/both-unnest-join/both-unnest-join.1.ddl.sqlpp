/*
 * Description  : Both sides of a join predicate come from an unnested array. naiveJoinSelectivity
 *              : skips "the side with an array" by taking the other side, but when both sides are
 *              : unnested the other side is an array side too, so the distinct count is measured
 *              : over unnested tuples while the estimator's sample size and cardinality cap are
 *              : both document counts. This pins the estimate that results.
 * Expected Res : Success
 */

drop dataverse test if exists;
create dataverse test;
use test;

create dataset collA(id uuid not unknown) open type primary key `id` autogenerated;
create dataset collB(id uuid not unknown) open type primary key `id` autogenerated;
