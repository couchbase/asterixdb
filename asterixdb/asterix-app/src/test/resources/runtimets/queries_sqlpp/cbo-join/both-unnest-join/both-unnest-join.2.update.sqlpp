use test;

-- 20000 documents, each holding a 10 element array, so an unnested scan emits 200000 tuples while
-- the collection holds 20000 documents. The key takes 3000 distinct values across the whole
-- collection, which is above the 1063 document sample target and far below the document count.
INSERT INTO collA (
    SELECT VALUE {
        "a_id": i,
        "lines": (SELECT VALUE { "k": (i * 10 + j) % 3000 } FROM range(0, 9) j)
    }
    FROM range(1, 20000) i
);

INSERT INTO collB (
    SELECT VALUE {
        "b_id": i,
        "lines": (SELECT VALUE { "k": (i * 10 + j) % 3000 } FROM range(0, 9) j)
    }
    FROM range(1, 20000) i
);
