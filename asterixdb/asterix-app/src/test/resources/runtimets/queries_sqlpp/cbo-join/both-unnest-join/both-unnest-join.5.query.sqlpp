/*
 * Description  : Ground truth for the estimate pinned in step 4. The unnested scan emits 200000
 *              : tuples from 20000 documents and the join key takes 3000 distinct values, so the
 *              : true join selectivity is 1/3000. Step 4 records what the optimizer estimates
 *              : instead.
 * Expected Res : Success
 */

use test;

SELECT COUNT(DISTINCT la.k) AS true_distinct_keys,
       COUNT(*)             AS unnested_tuples
FROM collA a, a.lines la;
